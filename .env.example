# Copy to .env and change the values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: access token lifetime (default 30)
JWT_ACCESS_MINUTES=30

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_HOST=localhost
# Host-side ports (docker-compose maps db to 5433, redis to 6380).
# Containers override these to talk to each other directly.
POSTGRES_PORT=5433

REDIS_URL=redis://localhost:6380/0
